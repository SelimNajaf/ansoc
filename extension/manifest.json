{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "description": "__MSG_ext_desc__",
  "version": "2.5.1",
  "default_locale": "en",
  "key": "",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Media Downloader",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": [
    "downloads",
    "storage",
    "scripting",
    "activeTab",
    "notifications",
    "nativeMessaging",
    "cookies",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.pinterest.com/*",
    "https://*.pinterest.ca/*",
    "https://*.pinterest.co.uk/*",
    "https://*.pinterest.de/*",
    "https://*.pinterest.fr/*",
    "https://*.pinterest.es/*",
    "https://*.pinterest.it/*",
    "https://*.pinterest.pt/*",
    "https://*.pinterest.ch/*",
    "https://*.pinterest.at/*",
    "https://*.pinterest.ie/*",
    "https://*.pinterest.nz/*",
    "https://*.pinterest.ph/*",
    "https://*.pinterest.cl/*",
    "https://*.pinterest.jp/*",
    "https://*.pinterest.kr/*",
    "https://*.pinterest.se/*",
    "https://*.pinterest.dk/*",
    "https://*.pinterest.ru/*",
    "https://*.pinterest.com.au/*",
    "https://*.pinterest.com.mx/*",
    "https://*.pinterest.co.kr/*",
    "https://*.pinterest.com.br/*",
    "https://*.tiktok.com/*",
    "https://*.instagram.com/*",
    "https://pin.it/*",
    "https://*.pinimg.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.pinterest.com/*",
        "https://*.pinterest.ca/*",
        "https://*.pinterest.co.uk/*",
        "https://*.pinterest.de/*",
        "https://*.pinterest.fr/*",
        "https://*.pinterest.es/*",
        "https://*.pinterest.it/*",
        "https://*.pinterest.pt/*",
        "https://*.pinterest.ch/*",
        "https://*.pinterest.at/*",
        "https://*.pinterest.ie/*",
        "https://*.pinterest.nz/*",
        "https://*.pinterest.ph/*",
        "https://*.pinterest.cl/*",
        "https://*.pinterest.jp/*",
        "https://*.pinterest.kr/*",
        "https://*.pinterest.se/*",
        "https://*.pinterest.dk/*",
        "https://*.pinterest.ru/*",
        "https://*.pinterest.com.au/*",
        "https://*.pinterest.com.mx/*",
        "https://*.pinterest.co.kr/*",
        "https://*.pinterest.com.br/*",
        "https://*.tiktok.com/*",
        "https://*.instagram.com/*"
      ],
      "js": [
        "utils/constants.js",
        "utils/pinterest.js",
        "utils/platforms.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}